# API key for AI photo analysis. Pick ONE provider.
# OpenAI (gpt-4o / gpt-4o-mini support vision)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (claude-3.5-sonnet supports vision)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Which provider to use: "openai" or "anthropic"
AI_PROVIDER=anthropic
