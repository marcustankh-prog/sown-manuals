{# Beaded Flower Manual — single-flower template (Sown.objects).
   Variables: see src/models.py (Flower).
   `accent` is a hex color string injected from the flower's palette. #}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ flower.title }}</title>
  <link rel="stylesheet" href="{{ stylesheet_href }}">
  <style>:root { --accent: {{ accent }}; --accent-soft: {{ accent_soft }}; }</style>
</head>
<body>

{# -------------------- COVER -------------------- #}
<section class="page cover">
  <header>
    <div class="cover-brand">SOWN</div>
    <div class="cover-eyebrow">Beaded Flower Pattern</div>
    <h1 class="cover-title">{{ flower.title }}</h1>
    <hr class="hairline">
    <div class="byline">a pattern by {{ flower.author }}</div>
  </header>

  <div>
    {% if flower.hero_image %}
      <img class="hero" src="{{ flower.hero_image }}" alt="{{ flower.name }}">
    {% endif %}

    <p class="intro-text">{{ flower.intro }}</p>

    {% if flower.palette %}
      <div class="palette-strip">
        {% for hex in flower.palette %}
          <span class="swatch" style="background: {{ hex }}"></span>
        {% endfor %}
      </div>
    {% endif %}

    {% if flower.materials %}
      <div class="materials-block">
        <h3>Materials</h3>
        {% if flower.yields %}<p style="margin:0 0 8pt 0; font-size:9.5pt; color:var(--muted); font-style:italic;">{{ flower.yields }}</p>{% endif %}
        <ul class="materials-grid">
          {% for m in flower.materials %}
            <li>{{ m.name }}{% if m.quantity %} <span style="color:var(--muted)">({{ m.quantity }})</span>{% endif %}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

  </div>
</section>

{# -------------------- ANATOMY DIAGRAM -------------------- #}
{% if flower.anatomy_diagram %}
<section class="page">
  <span class="section-label">01 — Anatomy</span>
  <h2 class="section">The parts you'll be making</h2>
  <hr class="hairline">
  <p class="section-intro">An overview of every piece you'll bead before assembling the
  finished {{ flower.name|lower }}. Each labelled part below has its own
  step-by-step section in the pages that follow.</p>
  <figure class="anatomy">
    <img src="{{ flower.anatomy_diagram.path }}" alt="Parts of the {{ flower.name }}">
    {% if flower.anatomy_diagram.caption %}
      <figcaption>{{ flower.anatomy_diagram.caption }}</figcaption>
    {% endif %}
  </figure>
</section>
{% endif %}

{# -------------------- COMPONENTS -------------------- #}
{% for c in flower.components %}
<section class="page">
  {% if loop.first %}
    <span class="section-label">02 — Components</span>
    <h2 class="section">How to make the {{ flower.name }}</h2>
    <hr class="hairline">
  {% endif %}

  <article class="component">
    <h3>{{ c.heading }}</h3>
    {% if c.count_label %}<div class="count">{{ c.count_label }}</div>{% endif %}
    {% if c.plain_description %}
      <p class="plain-desc">{{ c.plain_description }}</p>
    {% endif %}

    {% for para in c.paragraphs %}
      <p>{{ para }}</p>
    {% endfor %}

    {% if c.tip %}
      <div class="callout tip"><strong>Tip</strong> {{ c.tip }}</div>
    {% endif %}
    {% if c.note %}
      <div class="callout note"><strong>Note</strong> {{ c.note }}</div>
    {% endif %}

    {% if c.images %}
      <div class="image-row">
        {% for img in c.images %}
          <figure>
            <img src="{{ img.path }}" alt="">
            {% if img.caption %}<figcaption>{{ img.caption }}</figcaption>{% endif %}
          </figure>
        {% endfor %}
      </div>
    {% endif %}
  </article>
</section>
{% endfor %}

{# -------------------- ASSEMBLY -------------------- #}
{% if flower.assembly %}
<section class="page">
  <span class="section-label">03 — Assembly</span>
  <h2 class="section">{{ flower.assembly.heading }}</h2>
  <hr class="hairline">
  {% for para in flower.assembly.paragraphs %}
    <p>{{ para }}</p>
  {% endfor %}
  {% if flower.assembly.images %}
    <div class="image-row">
      {% for img in flower.assembly.images %}
        <figure>
          <img src="{{ img.path }}" alt="">
          {% if img.caption %}<figcaption>{{ img.caption }}</figcaption>{% endif %}
        </figure>
      {% endfor %}
    </div>
  {% endif %}
</section>
{% endif %}

{# -------------------- INSPO -------------------- #}
{% if flower.inspo_images %}
<section class="page">
  <div class="inspo-eyebrow">04 — Inspiration</div>
  <div class="inspo-title">{{ flower.name }}</div>
  <div class="inspo">
    {% for img in flower.inspo_images %}
      <img src="{{ img.path }}" alt="">
    {% endfor %}
  </div>
</section>
{% endif %}

{# -------------------- COPYRIGHT -------------------- #}
<section class="page">
  <div class="copyright">
    <span class="section-label">Colophon</span>
    <h2>Copyright &amp; Terms of Use</h2>
    <hr class="hairline">
    {% if flower.copyright_text %}
      <p>{{ flower.copyright_text }}</p>
    {% else %}
      <p>This pattern and instructions are &copy; {{ flower.copyright_holder }}, {{ flower.copyright_year }}.
         All rights reserved. For personal use only — please do not redistribute or resell.
         Thank you for supporting handmade pattern designers.</p>
    {% endif %}
    <div class="copyright-mark">SOWN</div>
  </div>
</section>

</body>
</html>
